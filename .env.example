# Copy this file to .env and replace every value marked CHANGE_ME.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (the docker-compose service uses these same defaults)
DATABASE_URL=postgres://trackstack:trackstack_dev_password@localhost:5432/trackstack
POSTGRES_USER=trackstack
POSTGRES_PASSWORD=trackstack_dev_password
POSTGRES_DB=trackstack
POSTGRES_PORT=5432

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_MAX_AGE_DAYS=14
COOKIE_SECURE=false
TRUST_PROXY=false

# iTunes Search API
ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_TIMEOUT_MS=8000
ITUNES_CACHE_TTL_MS=300000

# Optional: used by the test suite. Create it with `npm run db:test:setup`.
TEST_DATABASE_URL=postgres://trackstack:trackstack_dev_password@localhost:5432/trackstack_test
