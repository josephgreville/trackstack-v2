# Environment for the native Android build (`vite build --mode mobile`).
#
# Copy this file to `.env.mobile` and point VITE_API_URL at a server the
# phone can actually reach:
#
#   Android emulator  ->  http://10.0.2.2:4000/api/v1
#   Physical device    ->  http://192.168.x.x:4000/api/v1  (your LAN address)
#   Deployed server    ->  https://your-domain.com/api/v1
#
# The app can also be pointed at a different address at runtime from the
# in-app server setting, so a rebuild is not always needed.

VITE_API_URL=http://10.0.2.2:4000/api/v1
