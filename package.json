{
  "name": "trackstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrackStack — a warm, tactile home for your music collection.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "preview": "npm run preview --workspace client",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:test:setup": "npm run db:test:setup --workspace server",
    "test": "npm run db:test:setup && vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:server": "npm run db:test:setup && vitest run --project server --maxWorkers=1",
    "test:database": "npm run db:test:setup && vitest run --project server --maxWorkers=1 server/tests/database.test.js",
    "test:client": "vitest run --project client",
    "test:coverage": "npm run db:test:setup && vitest run --coverage --maxWorkers=1",
    "verify": "npm run test && npm run build",
    "android:sync": "npx cap sync android",
    "android:build": "npm run build --workspace client -- --mode mobile && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build --workspace client -- --mode mobile && npx cap run android",
    "android:apk": "npm run android:build && cd android && gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
